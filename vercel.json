{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && pnpm install --frozen-lockfile",
  "buildCommand": "cd frontend && pnpm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{backend/app/**,backend/migrations/**,prompts/**,policy/**,evals/**}"
    }
  },
  "rewrites": [{ "source": "/api/v1/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/api/v1/cron/tick", "schedule": "45 3 * * *" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
