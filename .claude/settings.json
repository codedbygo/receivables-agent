{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "_readme": [
    "Shared Claude Code settings for this repository.",
    "Personal overrides go in .claude/settings.local.json.",
    "Claude can run Bash commands autonomously for development and testing.",
    "All Bash commands are automatically allowed unless explicitly blocked by the deny list.",
    "Local network access is enabled for sandbox processes where supported.",
    "Dangerous/destructive operations remain blocked by the deny list."
  ],

  "extraKnownMarketplaces": {
    "bearing": {
      "source": {
        "source": "git",
        "url": "https://github.com/Deepta-AI/bearing"
      }
    }
  },

  "enabledPlugins": {
    "bearing@bearing": true,
    "bearing-backend@bearing": true,
    "superpowers@claude-plugins-official": true
  },

  "permissions": {
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "Bash(*)",

      "Skill(setup-browser-cookies)",
      "Skill(codex)",
      "Skill(benchmark-models)",
      "Skill(pair-agent)",
      "Skill(land-and-deploy)",
      "Skill(setup-deploy)",
      "Skill(gsd-ship)",
      "Skill(gsd-review)",
      "Skill(gsd-plan-review-convergence)",
       "Bash(~/.cache/ms-playwright/chromium-1243/chrome-linux64/chrome:*)"

    ],

    "ask": [],

    "deny": [
      "Bash(git push:*)",
      "Bash(git commit --amend:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git filter-repo:*)",
      "Bash(git filter-branch:*)",
      "Bash(git clean -fdx:*)",

      "Bash(git remote set-url:*)",
      "Bash(git remote remove:*)",
      "Bash(git remote rm:*)",
     

      "Bash(git branch -D:*)",
      "Bash(git branch --delete --force:*)",

      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git worktree remove:*)",

      "Bash(git reflog expire:*)",
      "Bash(git gc --prune:*)",
      "Bash(git update-ref -d:*)",

      "Bash(git tag -d:*)",
      "Bash(git tag --delete:*)",

      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review --approve:*)",
      "Bash(gh release create:*)",
      "Bash(gh release delete:*)",
      "Bash(gh repo delete:*)",

      "Bash(glab mr create:*)",
      "Bash(glab mr merge:*)",
      "Bash(glab mr approve:*)",
      "Bash(glab release create:*)",
      "Bash(glab release delete:*)",
      "Bash(glab repo delete:*)",

      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(cargo publish:*)",
      "Bash(uv publish:*)",
      "Bash(poetry publish:*)",
      "Bash(gem push:*)",
      "Bash(mvn deploy:*)",
      "Bash(gradle publish:*)",

      "Bash(docker push:*)",
      "Bash(docker image push:*)",
      "Bash(docker compose push:*)",
      "Bash(docker build --push:*)",
      "Bash(docker buildx build --push:*)",

      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state rm:*)",
      "Bash(terraform state push:*)",

      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl rollout:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl replace:*)",
      "Bash(kubectl drain:*)",
      "Bash(kubectl cordon:*)",

      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(helm delete:*)",
      "Bash(helm rollback:*)",

      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(vercel promote:*)",
      "Bash(vercel rollback:*)",
      "Bash(vercel remove:*)",
      "Bash(vercel rm:*)",
      "Bash(vercel env rm:*)",
      "Bash(vercel project rm:*)",
      "Bash(vercel domains rm:*)",

      "Bash(neonctl projects delete:*)",
      "Bash(neonctl branches delete:*)",
      "Bash(neonctl databases delete:*)",
      "Bash(neonctl roles delete:*)",

      "Bash(neon projects delete:*)",
      "Bash(neon branches delete:*)",
      "Bash(neon databases delete:*)",
      "Bash(neon roles delete:*)",

      "Bash(gcloud run deploy:*)",
      "Bash(gcloud app deploy:*)",
      "Bash(gcloud functions deploy:*)",

      "Bash(aws deploy:*)",
      "Bash(aws cloudformation deploy:*)",
      "Bash(aws cloudformation delete-stack:*)",

      "Bash(supabase db push:*)",
      "Bash(supabase functions deploy:*)",

      "Bash(netlify deploy:*)",
      "Bash(railway up:*)",
      "Bash(serverless deploy:*)",
      "Bash(sls deploy:*)",
      "Bash(sam deploy:*)",
      "Bash(cdk deploy:*)",
      "Bash(cdk destroy:*)",

      "Bash(rm -rf:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(killall:*)",

      "Bash(eval:*)",
      "Bash(sh -c:*)",
      "Bash(bash -c:*)",
      "Bash(xargs:*)",

      "Bash(ssh:*)",
      "Bash(scp:*)",

      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.prod)",
      "Read(./.env.staging)",
      "Read(./.env.development)",
      "Read(./.env.dev)",
      "Read(./.env.test)",

      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.staging)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.test)",

      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*service-account*.json)",
      "Read(**/gcp-key*.json)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",

      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.gradle/gradle.properties)"
    ],

    "defaultMode": "dontAsk"
  },

  "env": {
    "TZ": "UTC",
    "FORCE_COLOR": "1",
    "DO_NOT_TRACK": "1"
  },

  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,

    "autoAllowBashIfSandboxed": true,

    "allowUnsandboxedCommands": false,
    

    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "registry.yarnpkg.com",
       


        "pypi.org",
        "files.pythonhosted.org",

        "proxy.golang.org",
        "sum.golang.org",

        "repo.maven.apache.org",
        "repo1.maven.org",

        "dl.google.com",
        "maven.google.com",
        "plugins.gradle.org",
        "services.gradle.org",

        "pub.dev",
        "storage.googleapis.com",

        "registry.terraform.io",
        "releases.hashicorp.com",

        "vuln.go.dev",
        "api.osv.dev",
        "osv-vulnerabilities.storage.googleapis.com",

        "releases.astral.sh",

        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",

        "github.com",
        "*.github.com",

        "vercel.com",
        "api.vercel.com",
        "*.vercel.com",
        "*.vercel.app",

        "neon.tech",
        "console.neon.tech",
        "*.neon.tech",

        "localhost",
        "127.0.0.1"
      ],
      "allowAllUnixSockets": true,
      "allowLocalBinding": true,
      "allowUnixSockets": ["/tmp/.X11-unix/X0", "/run/user/1000/wayland-0"]
      

    },

    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache",
        "~/.local/share/pnpm",
        "~/Library/pnpm",
        "~/Library/Caches",
        "~/go/pkg/mod",
        "~/.gradle",
        "~/.m2",
        "~/.pub-cache",
        "~/.local/share/com.vercel.cli",
        "~/Library/Application Support/com.vercel.cli",
        "~/.config/neonctl"
      ],

      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gcloud",
        "~/.kube",
        "~/.config/bearing",
        "~/.docker/config.json",
        "~/.netrc",
        "~/.git-credentials"
      ],

      "denyWrite": [
        "~/.ssh",
        "~/.config/bearing",
        "~/.gitconfig",
        "./.githooks",
        "./.git/hooks",
        "./.git/config"
      ]
    }
  }
}