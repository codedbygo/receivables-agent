# Copy to .env (never committed). Every variable the code reads is listed here (REQ-120).
# Secrets are empty here; fill them in your local copy only.
DATABASE_URL=postgresql+psycopg://collections:collections@postgres:5432/collections
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-haiku-4.5
LLM_MODE=replay
LLM_BUDGET_USD=2.00
LLM_MAX_TOKENS=500
LLM_TIMEOUT_S=20
SMTP_HOST=mailhog
SMTP_PORT=1025
# Real SMTP for the hosted demo (ADR-0016), e.g. Gmail: smtp.gmail.com, 587, STARTTLS, an app password.
# Empty SMTP_USER means the local Mailpit with no login.
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=
# Required with SMTP_USER: every message goes to this inbox, never to the seeded customers.
EMAIL_REDIRECT_TO=
# Serverless (ADR-0015): send right after approval; Vercel Cron calls /api/v1/cron/tick with this secret.
SEND_INLINE=false
CRON_SECRET=
MAILHOG_UI_URL=http://localhost:8025
DEMO_TODAY=2026-09-30
TZ=Asia/Kolkata
SENDING_ENABLED=true
AUTONOMY_MODE=manual
# Access codes, one per role (hosted demo): the console asks for one, the API reads it as a Bearer token.
# Pick long random values. An empty code disables that role.
ADMIN_TOKEN=
COLLECTOR_TOKEN=
VIEWER_TOKEN=
# true: the role header signs anyone in (your own machine only). The API refuses to start with this on
# when ALLOWED_HOSTS names a public host. Hosted demo: false, with the three codes above set.
DEMO_OPEN_ROLES=true
FEATURE_WHATSAPP=false
FEATURE_VOICE=false
FEATURE_PAYMENT_LINK=false
FEATURE_TRUSTED_MODE=false
BANK_WEBHOOK_SECRET=
MCP_TOKEN=
SESSION_SECRET=
CLASSIFY_MIN_CONFIDENCE=0.75
LOG_LEVEL=INFO
# Host headers the API answers to (blocks DNS rebinding). Add your hostname for a hosted demo.
ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver

# Hosted demo only (compose.prod.yaml; docs/environments.md). Compose stops when one is missing.
# The public name Caddy gets a certificate for and nginx answers to.
PUBLIC_HOST=
# Postgres password; takes effect when the data volume is first created.
POSTGRES_PASSWORD=
# Mailpit UI and API login, as user:password.
MAILPIT_UI_AUTH=

# make smoke (backend/app/smoke.py) against a running stack.
SMOKE_BASE_URL=http://localhost:8080
MCP_URL=http://127.0.0.1:8001/mcp
MAILPIT_URL=http://localhost:8025
